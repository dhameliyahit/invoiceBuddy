# Copy this file to `.env` for local development.
# On Vercel, set these in the Project Settings -> Environment Variables instead.

# MongoDB connection string (use MongoDB Atlas for production)
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/invoiceBuddy

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=replace-with-a-long-random-secret
